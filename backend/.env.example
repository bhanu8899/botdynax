# Real Postgres connection string (e.g. Render's managed Postgres —
# copy its "Internal Database URL" here as DATABASE_URL on the web service).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

PORT=3000

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Optional — only needed for the direct-firmware BLE/WiFi/MQTT robot path.
# Tuya-based robots (e.g. the Milagrow W300) don't use this at all; leave
# unset on a plain cloud web service with no broker deployed alongside it.
MQTT_URL=

# Required for real Google/Apple sign-in verification — see AuthService.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Tuya Cloud — from your Tuya IoT Platform Cloud Project (see backend/README.md).
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_SCHEMA=
TUYA_REDIRECT_URI=botdynax://tuya-callback
